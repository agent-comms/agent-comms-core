{
  "name": "@agent-comms/core",
  "version": "0.1.1",
  "author": "Shay Palachy Affek",
  "private": false,
  "type": "module",
  "bin": {
    "agent-comms": "scripts/agent-comms.mjs"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:demo": "VITE_AGENT_COMMS_DEMO=1 VITE_BASE=/agent-comms-demo/ npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "local:bootstrap": "node scripts/local-runtime.mjs bootstrap",
    "local:migrate": "node scripts/local-runtime.mjs migrate",
    "local:host": "node scripts/local-runtime.mjs host",
    "local:reset": "node scripts/local-runtime.mjs reset-help",
    "test": "vitest run",
    "check": "tsc -b"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vitest": "^4.1.7"
  }
}
